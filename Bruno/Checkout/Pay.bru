meta {
  name: Pay
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/ekom/checkout/pay?culture=is-IS
  body: json
  auth: none
}

params:query {
  culture: is-IS
}

body:json {
  {
    "PaymentProvider": "", // Optional
    "ShippingProvider": "", // Optional 
    "CardNumber": "", // Optional
    "CVV": "", // Optional // Optional
    "Year": 2024, // Optional
    "Month": 10, // Optional
    "StoreAlias": "store", // Optional
    "Culture": "is-IS", // Optional
    "ReturnUrl": "/success-page", // Optional
    "customerTest": ""
  }
}
