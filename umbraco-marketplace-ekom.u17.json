{
  "$schema": "https://marketplace.umbraco.com/umbraco-marketplace-schema.json",
  "Title": "Ekom",
  "Description": "Ekom is a free, open-source e-commerce package for Umbraco. The catalog is Umbraco content, so editors manage products where they already work. Orders, customers and analytics are handled in a manager inside the backoffice.",
  "Category": "Commerce",
  "PackageType": "Package",
  "LicenseTypes": [
    "Free"
  ],
  "VersionSpecificPackageIds": [
    {
      "UmbracoMajorVersion": 13,
      "PackageId": "Ekom.U10"
    },
    {
      "UmbracoMajorVersion": 18,
      "PackageId": "Ekom.U18"
    },
    {
      "UmbracoMajorVersion": 19,
      "PackageId": "Ekom.U19"
    }
  ],
  "Tags": [
    "ecommerce",
    "orders",
    "checkout",
    "catalog",
    "payments",
    "multi-store",
    "headless"
  ],
  "DocumentationUrl": "https://vettvangur.gitbook.io/ekom",
  "IssueTrackerUrl": "https://github.com/Vettvangur/Ekom/issues",
  "AuthorDetails": {
    "Name": "Vettvangur",
    "Description": "Vettvangur is a digital agency in Iceland that builds and maintains Ekom.",
    "Url": "https://www.vettvangur.is",
    "ImageUrl": "https://github.com/Vettvangur.png",
    "SyncContributorsFromRepository": true
  },
