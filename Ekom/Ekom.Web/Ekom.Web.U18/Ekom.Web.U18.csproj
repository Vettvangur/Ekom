<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ContentTargetFolders>.</ContentTargetFolders>

        <PackageId>Ekom.Web.U18</PackageId>
        <Title>Ekom.Web.U18</Title>
        <Authors>Vettvangur</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/Vettvangur/Ekom</PackageProjectUrl>
        <PackageIcon>images/VV_Logo.png</PackageIcon>
        <Description>Ekom Web assets for Umbraco 18.</Description>
        <Copyright>Copyright 2026</Copyright>
        <PackageTags>umbraco;ecommerce;ekom</PackageTags>

        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TF_BUILD)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>
    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../../VV_Logo.png" Pack="true" PackagePath="images/" />
        <Content Include="App_Plugins\Ekom\**" ExcludeFromSingleFile="true" CopyToPublishDirectory="Always" />
        <None Include="buildTransitive/**" Pack="true" PackagePath="buildTransitive" />
    </ItemGroup>

    <Target Name="NpmInstallEkomWebU18" BeforeTargets="Build" Condition="!Exists('Client/node_modules')">
        <Exec WorkingDirectory="Client" Command="npm ci" />
    </Target>

    <Target Name="BuildEkomWebU18Assets" BeforeTargets="Build" DependsOnTargets="NpmInstallEkomWebU18">
        <Exec WorkingDirectory="Client" Command="npm run build" />
    </Target>

    <Target Name="AddEkomWebU18AssetsToPackage" BeforeTargets="GenerateNuspec" DependsOnTargets="BuildEkomWebU18Assets">
        <ItemGroup>
            <None Include="App_Plugins/Ekom/**" Pack="true" PackagePath="contentFiles/any/any/App_Plugins/Ekom" />
        </ItemGroup>
    </Target>

</Project>
