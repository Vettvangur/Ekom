<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Ekom.Mailchimp.U18</PackageId>
    <Version>1.3.0</Version>
    <Authors>Vettvangur</Authors>
    <Company>Vettvangur</Company>
    <Description>Mailchimp integration for Ekom on Umbraco 18.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Vettvangur/Ekom</PackageProjectUrl>
    <PackageTags>ekom;umbraco;mailchimp;ecommerce</PackageTags>
    <RepositoryUrl>https://github.com/Vettvangur/Ekom</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>images/VV_Logo.png</PackageIcon>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DefineConstants>$(DefineConstants);UMBRACO_18</DefineConstants>
    <EkomPackageVersion>0.2.276</EkomPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.2"/>
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.2"/>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="1.0.0" PrivateAssets="All"/>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
  </ItemGroup>

  <ItemGroup Condition="'$(UseProjectReferences)' == 'true'">
    <ProjectReference Include="..\..\..\Ekom\Ekom.Umbraco\Ekom.U18\Ekom.U18.csproj"/>
  </ItemGroup>

  <ItemGroup Condition="'$(UseProjectReferences)' != 'true'">
    <PackageReference Include="Ekom.U18" Version="$(EkomPackageVersion)"/>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\**\*.cs" Exclude="..\bin\**\*.cs;..\obj\**\*.cs;..\U18\bin\**\*.cs;..\U18\obj\**\*.cs"/>
    <None Include="..\README.md" Pack="true" PackagePath="\"/>
    <None Include="..\CHANGELOG.md" Pack="true" PackagePath="\"/>
    <None Include="..\..\..\VV_Logo.png" Link="VV_Logo.png" Pack="true" PackagePath="images/"/>
  </ItemGroup>

</Project>
