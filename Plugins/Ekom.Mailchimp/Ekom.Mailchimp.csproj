<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Ekom.Mailchimp</PackageId>
    <Version>1.0.0</Version>
    <Authors>Vettvangur</Authors>
    <Company>Vettvangur</Company>
    <Description>Mailchimp audience and e-commerce integration for Ekom.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Vettvangur/Ekom</PackageProjectUrl>
    <PackageTags>ekom;umbraco;mailchimp;ecommerce</PackageTags>
    <RepositoryUrl>https://github.com/Vettvangur/Ekom</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>images/VV_Logo.png</PackageIcon>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <EkomPackageVersion>0.2.276</EkomPackageVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <DefineConstants>$(DefineConstants);UMBRACO_17</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="1.0.0" PrivateAssets="All" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseProjectReferences)' == 'true' and '$(TargetFramework)' == 'net8.0'">
    <ProjectReference Include="..\..\Ekom\Ekom.Core\Ekom\Ekom.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseProjectReferences)' == 'true' and '$(TargetFramework)' == 'net10.0'">
    <ProjectReference Include="..\..\Ekom\Ekom.Umbraco\Ekom.U17\Ekom.U17.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseProjectReferences)' != 'true' and '$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Ekom.Core" Version="$(EkomPackageVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseProjectReferences)' != 'true' and '$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Ekom.U17" Version="$(EkomPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="U18\**\*.cs;Umbraco\**\*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Include="Umbraco\Shared\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="CHANGELOG.md" Pack="true" PackagePath="\" />
    <None Include="..\..\VV_Logo.png" Link="VV_Logo.png" Pack="true" PackagePath="images/" />
  </ItemGroup>

</Project>
