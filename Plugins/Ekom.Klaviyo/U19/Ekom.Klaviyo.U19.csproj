<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <DefineConstants>$(DefineConstants);UMBRACO_18;UMBRACO_19</DefineConstants>

        <PackageId>Ekom.Klaviyo.U19</PackageId>
        <Title>Ekom Klaviyo Plugin for Umbraco 19</Title>
        <Description>Ekom Klaviyo integration plugin for Umbraco 19.</Description>
        <Authors>Vettvangur</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/Vettvangur/Ekom</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Vettvangur/Ekom</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageIcon>images/Ekom_Logo.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Copyright>Copyright 2026</Copyright>
        <PackageTags>umbraco;ecommerce;ekom;b2c;b2b;klaviyo;plugin;extension</PackageTags>

        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <EkomPackageVersion>0.2.255</EkomPackageVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TF_BUILD)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>
    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\**\*.cs"
                 Exclude="..\Umbraco\U10\**\*.cs;..\Umbraco\U17\**\*.cs;..\bin\**\*.cs;..\obj\**\*.cs;..\U18\**\*.cs;..\U19\**\*.cs" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\README.md" Link="README.md" Pack="true" PackagePath="" />
        <None Include="..\Ekom_Logo.png" Link="Ekom_Logo.png" Pack="true" PackagePath="images/" />
        <None Include="..\CHANGELOG.md" Link="CHANGELOG.md" Pack="true" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0" />
        <PackageReference Include="Microsoft.Extensions.Options" Version="11.0.0" />
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="1.0.0" PrivateAssets="All" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="Umbraco.Cms.Api.Management" Version="[19.0.0-rc1,20.0.0)" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseProjectReferences)' == 'true'">
        <ProjectReference Include="..\..\..\Ekom\Ekom.Umbraco\Ekom.U19\Ekom.U19.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseProjectReferences)' != 'true'">
        <PackageReference Include="Ekom.U19" Version="$(EkomPackageVersion)" />
    </ItemGroup>

</Project>
