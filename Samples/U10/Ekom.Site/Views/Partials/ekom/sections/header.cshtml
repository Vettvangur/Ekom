@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

@{
    var rootNode = Model.GetRootNode();
    var rootCategories = _catalog.GetRootCategories();
    var order = await _order.GetOrderAsync();
    var currentStore = _store.GetStore();
    var checkoutNode = rootNode.FirstChildOfType("checkout");
    var signInNode = rootNode.FirstChildOfType("signIn");
    var registerNode = rootNode.FirstChildOfType("register");
    var searchStoreAlias = currentStore?.Alias ?? "Store";
    var searchLocale = currentStore?.Culture?.Name ?? string.Empty;
    var searchCurrency = currentStore?.GetCurrentCurrency()?.CurrencyValue ?? currentStore?.Currency?.CurrencyValue ?? string.Empty;
}
<!-- Top navigation -->
<nav aria-label="Top" class="relative z-20 bg-white bg-opacity-90 backdrop-blur-xl backdrop-filter">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center">
            <!-- Mobile menu toggle, controls the 'mobileMenuOpen' state. -->
            <button type="button" class="relative rounded-md bg-white p-2 text-gray-400 lg:hidden">
                <span class="absolute -inset-0.5"></span>
                <span class="sr-only">Open menu</span>
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                </svg>
            </button>

            <!-- Logo -->
            <div class="ml-4 flex lg:ml-0">
                <a href="@rootNode.Url()">
                    <span class="sr-only">Ekom</span>
                    <img class="h-5 w-auto" src="/content/ekomlogo.svg" alt="Ekom">
                </a>
            </div>

            <!-- Flyout menus -->
            <div class="hidden lg:ml-8 lg:block lg:self-stretch">
                <div class="flex h-full space-x-8">

                    @foreach (var rootCategory in rootCategories)
                    {
                        <div class="flex">
                            <div class="relative flex">
                                <!-- Item active: "border-indigo-600 text-indigo-600", Item inactive: "border-transparent text-gray-700 hover:text-gray-800" -->
                                <a href="@rootCategory.Url" class="@(rootCategory.IsCurrent(Model.Path) ? "text-indigo-600 hover:text-indigo-500" : "text-gray-700 hover:text-gray-800") border-transparent relative z-10 -mb-px flex items-center border-b-2 pt-px text-sm font-medium transition-colors duration-200 ease-out" aria-expanded="false">@rootCategory.Title</a>
                            </div>
                        </div>
                    }

                    <a href="#" class="flex items-center text-sm font-medium text-gray-700 hover:text-gray-800">Company</a>
                    <a href="#" class="flex items-center text-sm font-medium text-gray-700 hover:text-gray-800">Stores</a>
                </div>
            </div>

            <div class="ml-auto flex items-center">
                <div class="hidden lg:flex lg:flex-1 lg:items-center lg:justify-end lg:space-x-6">
                    @if (Context.User.Identity.IsAuthenticated)
                    {
                        <a href="/umbraco/surface/auth/logout" class="text-sm font-medium text-gray-700 hover:text-gray-800">Log out</a>
                    }
                    else
                    {
                        if (signInNode != null)
                        {
                            <a href="@signInNode.Url()" class="text-sm font-medium text-gray-700 hover:text-gray-800">Sign in</a>
                        }
                        
                    }
                    
                    <span class="h-6 w-px bg-gray-200" aria-hidden="true"></span>
                    @if (registerNode != null)
                    {
                        <a href="@registerNode.Url()" class="text-sm font-medium text-gray-700 hover:text-gray-800">Create account</a>
                    }
                </div>

                <div class="ml-4 hidden lg:block lg:w-full lg:max-w-md">
                    <div class="relative"
                         x-data="searchAutocomplete('@searchStoreAlias', '@searchLocale', '@searchCurrency')"
                         @@click.outside="close()"
                         @@keydown.escape.window="close()">
                        <div class="relative">
                            <input type="search"
                                   x-model="term"
                                   @@input="queueSearch()"
                                   @@focus="openPanel()"
                                   placeholder="Search products"
                                   class="w-full rounded-full border border-gray-200 bg-gray-50 py-2.5 pl-11 pr-4 text-sm text-gray-900 shadow-sm outline-none transition focus:border-gray-300 focus:bg-white focus:ring-2 focus:ring-indigo-100"
                                   autocomplete="off">
                            <svg class="pointer-events-none absolute left-3 top-2.5 h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                            </svg>
                        </div>

                        <div x-show="isOpen"
                             class="absolute right-0 z-30 mt-3 w-full overflow-hidden rounded-3xl border border-gray-200 bg-white shadow-2xl">
                            <div class="border-b border-gray-100 bg-gray-50 px-4 py-3 text-xs font-semibold uppercase tracking-[0.2em] text-gray-500">
                                Autocomplete demo
                            </div>

                            <template x-if="message">
                                <div class="px-4 py-3 text-sm text-gray-500" x-text="message"></div>
                            </template>

                            <template x-if="isLoading">
                                <div class="px-4 py-3 text-sm text-gray-500">Searching...</div>
                            </template>

                            <div class="max-h-[32rem] overflow-y-auto" x-show="!isLoading && (suggestions.length || products.length)">
                                <template x-if="suggestions.length">
                                    <div class="border-b border-gray-100 p-4">
                                        <div class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-gray-500">Suggestions</div>
                                        <div class="flex flex-wrap gap-2">
                                            <template x-for="suggestion in suggestions" :key="suggestion.objectId ?? suggestion.query">
                                                <button type="button"
                                                        class="rounded-full border border-gray-200 bg-white px-3 py-1.5 text-sm text-gray-700 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700"
                                                        @@click="applySuggestion(suggestion.query)"
                                                        x-text="suggestion.query">
                                                </button>
                                            </template>
                                        </div>
                                    </div>
                                </template>

                                <template x-if="products.length">
                                    <div class="p-4">
                                        <div class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-gray-500">Products</div>
                                        <div class="space-y-3">
                                            <template x-for="product in products" :key="product.objectId">
                                                <a :href="product.url || '#'" class="flex items-center gap-3 rounded-2xl border border-transparent p-2 transition hover:border-gray-200 hover:bg-gray-50">
                                                    <div class="flex h-16 w-16 items-center justify-center overflow-hidden rounded-2xl bg-gray-100">
                                                        <template x-if="product.imageUrl">
                                                            <img :src="product.imageUrl" :alt="product.title" class="h-full w-full object-cover">
                                                        </template>
                                                        <template x-if="!product.imageUrl">
                                                            <span class="text-xs uppercase tracking-[0.2em] text-gray-400">Item</span>
                                                        </template>
                                                    </div>
                                                    <div class="min-w-0 flex-1">
                                                        <div class="truncate text-sm font-semibold text-gray-900" x-text="product.title"></div>
                                                        <div class="truncate text-sm text-gray-500" x-text="product.summary || product.sku || 'Indexed product result'"></div>
                                                    </div>
                                                    <div class="text-right text-sm">
                                                        <div class="font-semibold text-gray-900" x-text="formatPrice(product)"></div>
                                                        <div class="text-xs uppercase tracking-[0.2em] text-gray-400" x-text="product.available ? 'In stock' : 'View' "></div>
                                                    </div>
                                                </a>
                                            </template>
                                        </div>
                                    </div>
                                </template>
                            </div>
                        </div>
                    </div>
                </div>
                
                @if (checkoutNode != null)
                {
                    <!-- Cart -->
                    <div class="ml-4 flow-root lg:ml-6">
                        <a href="@checkoutNode.Url()" class="group -m-2 flex items-center p-2">
                            <svg class="h-6 w-6 flex-shrink-0 text-gray-400 group-hover:text-gray-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                            </svg>
                            <span class="ml-2 text-sm font-medium text-gray-700 group-hover:text-gray-800" data-cart-quantity>@(order != null ? order.TotalQuantity : 0)</span>
                            <span class="sr-only">items in cart, view bag</span>
                        </a>
                    </div>
                }


            </div>
        </div>
    </div>
</nav>

<script>
    function searchAutocomplete(storeAlias, locale, currency) {
        return {
            storeAlias,
            locale,
            currency,
            term: '',
            suggestions: [],
            products: [],
            isLoading: false,
            isOpen: false,
            message: 'Start typing to query suggestions and product matches.',
            debounceHandle: null,

            openPanel() {
                this.isOpen = true;
            },

            close() {
                this.isOpen = false;
            },

            queueSearch() {
                this.openPanel();
                clearTimeout(this.debounceHandle);
                this.debounceHandle = setTimeout(() => this.search(), 180);
            },

            async search() {
                const term = this.term.trim();

                if (term.length < 2) {
                    this.suggestions = [];
                    this.products = [];
                    this.isLoading = false;
                    this.message = 'Type at least 2 characters to search.';
                    return;
                }

                this.isLoading = true;
                this.message = '';

                try {
                    const [suggestionsResponse, productsResponse] = await Promise.all([
                        this.fetchJson('/ekom/search/suggestions', { query: term, hitsPerPage: 6 }),
                        this.fetchJson('/ekom/search/products', { query: term, hitsPerPage: 4 })
                    ]);

                    this.suggestions = suggestionsResponse.hits || [];
                    this.products = productsResponse.hits || [];
                    this.message = this.suggestions.length || this.products.length
                        ? ''
                        : 'No suggestions or products matched that search.';
                } catch (error) {
                    console.error(error);
                    this.suggestions = [];
                    this.products = [];
                    this.message = 'Search is unavailable right now.';
                } finally {
                    this.isLoading = false;
                }
            },

            async fetchJson(endpoint, params) {
                const url = new URL(endpoint, window.location.origin);
                url.searchParams.set('storeAlias', this.storeAlias);

                if (this.locale) {
                    url.searchParams.set('locale', this.locale);
                }

                if (this.currency) {
                    url.searchParams.set('currency', this.currency);
                }

                Object.entries(params).forEach(([key, value]) => {
                    if (value !== null && value !== undefined && value !== '') {
                        url.searchParams.set(key, value);
                    }
                });

                const response = await fetch(url, {
                    headers: {
                        'Accept': 'application/json'
                    }
                });

                if (!response.ok) {
                    throw new Error('Search request failed.');
                }

                return await response.json();
            },

            applySuggestion(query) {
                this.term = query || '';
                this.search();
            },

            formatPrice(product) {
                if (product.priceWithVat !== null && product.priceWithVat !== undefined) {
                    return `${product.priceWithVat} ${product.currency || ''}`.trim();
                }

                if (product.price !== null && product.price !== undefined) {
                    return `${product.price} ${product.currency || ''}`.trim();
                }

                return 'View item';
            }
        };
    }
</script>
