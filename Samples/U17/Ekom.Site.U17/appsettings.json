{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "d680e6b1-fad3-43d0-bec0-5a70e422306e"
      },
      "Hosting": {
        "Debug": false
      },
      "Runtime": {
        "Mode": "BackofficeDevelopment"
      }
    }
  },
  "Ekom": {
    "PerStoreStock": false,
    "ExamineSearchIndex": "ExternalIndex",
    "ShareBasket": false,
    "BasketCookieLifetime": 1,
    "CustomImage": "images",
    "ReservationTimeout": 30,
    "CategoryRootLevel": 3,
    "VatCalcRounding": "AwayFromZero",
    "VatRoundingScope": "PerUnit",
    "VatIncludedPerUnitPolicy": "PreserveStickerGross",
    "ApplyVatOnShipping": true,
    "UserBasket": false,
    "DisableStock": false,
    "AbsoluteUrls": false,
    "SectionAccessRules": "ekom"
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Ekom17.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  }
}