@inherits UmbracoViewPage

@{
    Layout = null;
}

<!doctype html>
<html lang="en">
<head>
    <partial name="ekom/utility/meta" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css">
    <script defer src="https://unpkg.com/alpinejs-form-data@latest/dist/form-data.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.tailwindcss.com?plugins=forms,typography,aspect-ratio"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        indigo: {
                            100: '#fee2e2',
                            200: '#fecaca',
                            300: '#fca5a5',
                            400: '#f87171',
                            500: '#ef4444',
                            600: '#dc2626',
                            700: '#b91c1c',
                            800: '#991b1b',
                            900: '#7f1d1d'
                        }
                    }
                }
            }
        }
    </script>
</head>
<body>
    <div class="bg-white">
        <header class="relative overflow-hidden">
            <partial name="ekom/sections/header" />
            @await RenderSectionAsync("Header", false)
        </header>

        @await RenderSectionAsync("Main", true)

        <partial name="ekom/sections/footer" />
    </div>
</body>
</html>
