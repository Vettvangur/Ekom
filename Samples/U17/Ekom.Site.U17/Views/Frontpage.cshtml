@inherits UmbracoViewPage

@{
    Layout = "Master.cshtml";
}

@section Header {
    <div class="pb-24 pt-16 sm:pb-32 sm:pt-24 lg:pb-40 lg:pt-32">
        <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="sm:max-w-lg">
                <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-6xl">Ekom U17 sample site</h1>
                <p class="mt-4 text-xl text-gray-500">A minimal Umbraco 17 storefront wired to the local Ekom.U17 project.</p>
            </div>
        </div>
    </div>
}

@section Main {
    <main>
        <section aria-labelledby="category-heading" class="bg-gray-50">
            <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
                <div class="sm:flex sm:items-baseline sm:justify-between">
                    <h2 id="category-heading" class="text-2xl font-bold tracking-tight text-gray-900">Shop by Category</h2>
                </div>

                <div class="mt-6 grid grid-cols-1 gap-y-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
                    @foreach (var category in _catalog.GetRootCategories())
                    {
                        <a href="@category.Url" class="group block overflow-hidden rounded-lg bg-white shadow-sm ring-1 ring-gray-200 transition hover:shadow-md">
                            <div class="h-48 bg-gray-100"></div>
                            <div class="p-6">
                                <h3 class="font-semibold text-gray-900 group-hover:text-indigo-600">@category.Title</h3>
                                <p class="mt-1 text-sm text-gray-500">Browse products</p>
                            </div>
                        </a>
                    }
                </div>
            </div>
        </section>
    </main>
}