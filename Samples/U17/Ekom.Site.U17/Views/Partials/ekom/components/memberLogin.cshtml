@using Ekom.Site.U17.Controllers
@inherits UmbracoViewPage

@{
    var signedIn = _memberManager.IsLoggedIn();
    var order = await _order.GetOrderAsync();
}

<section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <h2 class="text-xl font-semibold">Member login</h2>
    @if (signedIn)
    {
        <p class="mt-2">You are signed in.</p>
        @using (Html.BeginUmbracoForm<AuthController>("Logout"))
        {
            <button type="submit" class="mt-3 rounded bg-gray-700 px-4 py-2 text-white">Log out</button>
        }
    }
    else
    {
        @using (Html.BeginUmbracoForm<AuthController>("Login", null, new { @class = "mt-4 max-w-sm space-y-3" }))
        {
            <label for="member-username" class="block">Username</label>
            <input id="member-username" name="Username" autocomplete="username" required class="block w-full rounded border p-2" />
            <label for="member-password" class="block">Password</label>
            <input id="member-password" name="Password" type="password" autocomplete="current-password" required class="block w-full rounded border p-2" />
            <button type="submit" class="rounded bg-indigo-600 px-4 py-2 text-white">Log in</button>
        }
        @if (Context.Request.Query.ContainsKey("error"))
        {
            <p role="alert" class="mt-2 text-red-700">Login failed. Check your username and password.</p>
        }
    }
    @if (env.IsDevelopment())
    {
        <p class="mt-4 text-sm">Development pricing: members get 20% off, or the existing sale price if better. Add as guest, log in, then refresh the basket. Log out and refresh again to restore guest prices.</p>
        @using (Html.BeginUmbracoForm<AuthController>("Reinitialize"))
        {
            <input type="hidden" name="storeAlias" value="@order?.StoreInfo.Alias" />
            <button type="submit" disabled="@(order == null || order.OrderLines.Count == 0)" class="mt-3 rounded bg-indigo-600 px-4 py-2 text-white disabled:opacity-50">Reinitialise basket prices</button>
        }
        @if (Context.Request.Query.ContainsKey("pricesRefreshed"))
        {
            <p class="mt-2" role="status">Basket prices refreshed. Open the cart to check the prices.</p>
        }
    }
</section>
