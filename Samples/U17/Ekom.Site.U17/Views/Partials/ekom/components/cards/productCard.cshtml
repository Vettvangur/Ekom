@inherits UmbracoViewPage

@{
    var product = (IProduct?)ViewData["product"];

    if (product == null)
    {
        return;
    }

    var image = product.Images.FirstOrDefault();
    var media = image is not null ? Umbraco.Media(image.Key) : null;
    IHtmlContent? imageUrl = media is not null
        ? Url.GetCropUrl(media, width: 278, height: 384, furtherOptions: "&rmode=BoxPad&bgcolor=f7f7f7")
        : !string.IsNullOrWhiteSpace(image?.Url) ? Html.Raw(image.Url) : null;
    IHtmlContent? imageUrl2x = media is not null
        ? Url.GetCropUrl(media, width: 556, height: 768, furtherOptions: "&rmode=BoxPad&bgcolor=f7f7f7")
        : !string.IsNullOrWhiteSpace(image?.Url) ? Html.Raw(image.Url) : null;
}

<div class="group relative flex flex-col overflow-hidden rounded-lg border border-gray-200 bg-white">
    <div class="aspect-h-4 aspect-w-3 bg-gray-200 sm:aspect-none group-hover:opacity-75 sm:h-96">
        @if (imageUrl is not null && imageUrl2x is not null)
        {
            <picture class="h-full w-full object-cover object-center sm:h-full sm:w-full">
                <source media="(max-width: 576px)" srcset="@imageUrl 1x, @imageUrl2x 2x">
                <img alt="@product.Title" loading="lazy" src="@imageUrl" srcset="@imageUrl 1x, @imageUrl2x 2x">
            </picture>
        }
    </div>
    <div class="flex flex-1 flex-col space-y-2 p-4">
        <h3 class="text-sm font-medium text-gray-900">
            <a href="@product.Url">
                <span aria-hidden="true" class="absolute inset-0"></span>
                @product.Title
            </a>
        </h3>
        <p class="text-sm text-gray-500">@product.Summary</p>
        <div class="flex flex-1 flex-col justify-end">
            @if (product.Price.HasDiscount)
            {
                <p class="text-base font-medium text-gray-900"><span class="line-through">@product.Price.BeforeDiscount.CurrencyString</span> @product.Price.WithVat.CurrencyString</p>
            }
            else
            {
                <p class="text-base font-medium text-gray-900">@product.Price.WithVat.CurrencyString</p>
            }
        </div>
    </div>
</div>
