@inherits UmbracoViewPage

@{
    Layout = "Master.cshtml";

    var product = await _catalog.GetProductAsync();
    if (product == null)
    {
        return;
    }

    var primaryVariantGroup = product.PrimaryVariantGroup;
    var primaryVariant = product.PrimaryVariant;
    var images = product.Images;
}

@section Main {
    <main class="mx-auto mt-8 max-w-2xl px-4 pb-16 sm:px-6 sm:pb-24 lg:max-w-7xl lg:px-8">
        <div class="lg:grid lg:auto-rows-min lg:grid-cols-12 lg:gap-x-8">
            <div class="lg:col-span-5 lg:col-start-8">
                <div class="flex justify-between">
                    <h1 class="text-xl font-medium text-gray-900">@product.Title</h1>
                    @if (product.Price.HasDiscount)
                    {
                        <p class="text-xl font-medium text-gray-900"><span class="line-through">@product.Price.BeforeDiscount.CurrencyString</span> @product.Price.WithVat.CurrencyString</p>
                    }
                    else
                    {
                        <p class="text-xl font-medium text-gray-900">@product.Price.WithVat.CurrencyString</p>
                    }
                </div>
            </div>

            @if (images.Any())
            {
                <div class="mt-8 lg:col-span-7 lg:col-start-1 lg:row-span-3 lg:row-start-1 lg:mt-0">
                    <h2 class="sr-only">Images</h2>
                    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
                        @foreach (var image in images)
                        {
                            <img src="@image.Url" alt="@image.Description" class="rounded-lg" loading="lazy">
                        }
                    </div>
                </div>
            }

            <div class="mt-8 lg:col-span-5">
                @if (product.Available)
                {
                    @using (Html.BeginEkomForm(FormType.AddToOrderProduct, htmlAttributes: new Dictionary<string, object> { { "class", "product__add-form" } }))
                    {
                        <input type="hidden" name="storeAlias" value="@product.Store.Alias" />
                        <input type="hidden" name="productId" value="@product.Key" />
                        <input type="hidden" name="action" value="@OrderAction.AddOrUpdate" />

                        if (primaryVariantGroup != null)
                        {
                            <div class="mt-8">
                                <label for="variantId" class="block text-sm font-medium leading-6 text-gray-900">@primaryVariantGroup.Title</label>
                                <select id="variantId" name="variantId" class="mt-2 block w-full rounded-md border-gray-300 text-sm">
                                    @foreach (var variant in primaryVariantGroup.Variants)
                                    {
                                        <option value="@variant.Key" selected="@(primaryVariant?.Key == variant.Key)" disabled="@(!variant.Available)">@variant.Title</option>
                                    }
                                </select>
                            </div>
                        }

                        <div class="mt-8">
                            <label for="quantity" class="block text-sm font-medium leading-6 text-gray-900">Quantity</label>
                            <input type="number" name="quantity" id="quantity" class="mt-2 block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 sm:text-sm" value="1" min="1">
                        </div>

                        <button type="submit" class="mt-8 flex w-full items-center justify-center rounded-md border border-transparent bg-indigo-600 px-8 py-3 text-base font-medium text-white hover:bg-indigo-700">Add to cart</button>
                    }
                }
                else
                {
                    <div class="rounded-md bg-gray-100 p-4 text-gray-700">Out of stock</div>
                }

                <div class="mt-10">
                    <h2 class="text-sm font-medium text-gray-900">Description</h2>
                    <div class="prose prose-sm mt-4 text-gray-500">@Html.Raw(product.Description)</div>
                </div>
            </div>
        </div>
    </main>
}
